/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "game-of-tag",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-07",
	"migrations": [
		{
			"new_sqlite_classes": [
				"MyDurableObject"
			],
			"tag": "v1"
		},
		{
			"deleted_classes": [
				"MyDurableObject"
			],
			"new_sqlite_classes": [
				"Battlefield"
			],
			"tag": "v2"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "Battlefield",
				"name": "BATTLEFIELD"
			}
		]
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	/**
	 * Environment Variables
	 * IDLE_TIMEOUT_SECONDS: seconds of no client message (movement/fire/
	 * respawn) before a player is automatically logged out.
	 * ARMOR_RECOVER_AMOUNT / BULLET_RECOVER_AMOUNT: how much durability /
	 * ammo a picked-up item restores (capped at each stat's max).
	 * ARMOR_SPAWN_INTERVAL_SECONDS / BULLET_SPAWN_INTERVAL_SECONDS: how
	 * often each item type may appear on the field (skipped if one of that
	 * type is already out there).
	 * NPC_MAX_COUNT: max NPC tanks on the field at once (0 disables NPCs).
	 * NPC_SPAWN_INTERVAL_SECONDS: how often a new NPC appears (only while
	 * at least one user is logged in) until NPC_MAX_COUNT is reached.
	 * Changes take effect on the next deploy.
	 */
	"vars": {
		"IDLE_TIMEOUT_SECONDS": "180",
		"ARMOR_RECOVER_AMOUNT": "5",
		"BULLET_RECOVER_AMOUNT": "5",
		"ARMOR_SPAWN_INTERVAL_SECONDS": "60",
		"BULLET_SPAWN_INTERVAL_SECONDS": "60",
		"NPC_MAX_COUNT": "5",
		"NPC_SPAWN_INTERVAL_SECONDS": "3"
	}
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}